# Maintainer: Chronicle PDF Inc <contact@chronicle-pdf.com>
pkgname=Chronicle-PDF-desktop
pkgver=2.14.2
pkgrel=1
pkgdesc="Locally hosted, web-based PDF manipulation tool (Tauri desktop app, official Chronicle PDF Inc build)"
arch=('x86_64')
url="https://www.stirling.com"
license=('MIT' 'LicenseRef-Chronicle-PDF-Proprietary')
depends=('gtk3' 'webkit2gtk-4.1' 'libappindicator-gtk3')
provides=('Chronicle-PDF')
conflicts=('Chronicle-PDF' 'Chronicle-PDF-git' 'Chronicle-PDF-bin')
options=('!strip')

source_x86_64=("${pkgname}-${pkgver}.deb::https://github.com/aaronkr-navi/Chronicle-PDF/releases/download/v${pkgver}/Chronicle-PDF-linux-x86_64.deb")
sha256sums_x86_64=('PLACEHOLDER_DEB_SHA256')

package() {
    # Extract the .deb archive
    bsdtar -xf data.tar* -C "${pkgdir}"

    # Fix permissions
    find "${pkgdir}" -type d -exec chmod 755 {} \;

    # Install license
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" <<EOF
Copyright (c) 2025 Chronicle PDF Inc
All rights reserved. See https://github.com/aaronkr-navi/Chronicle-PDF/blob/main/LICENSE
EOF
}
