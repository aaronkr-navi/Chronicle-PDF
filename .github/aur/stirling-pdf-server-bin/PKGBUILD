# Maintainer: Chronicle PDF Inc <contact@chronicle-pdf.com>
pkgname=Chronicle-PDF-server-bin
pkgver=2.14.2
pkgrel=1
pkgdesc="Locally hosted, web-based PDF manipulation tool (server JAR, prebuilt)"
arch=('any')
url="https://www.chronicle-pdf.com"
license=('MIT' 'LicenseRef-Chronicle-PDF-Proprietary')
depends=('java-runtime>=25')
provides=('Chronicle-PDF-server')
conflicts=('Chronicle-PDF-server' 'Chronicle-PDF-server-git')
backup=('etc/Chronicle-PDF-server/settings.yml')

source=("Chronicle-PDF-with-login-${pkgver}.jar::https://github.com/aaronkr-navi/Chronicle-PDF/releases/download/v${pkgver}/Chronicle-PDF-with-login.jar")
sha256sums=('PLACEHOLDER_JAR_SHA256')

package() {
    # JAR
    install -Dm644 "Chronicle-PDF-with-login-${pkgver}.jar" \
        "${pkgdir}/usr/share/Chronicle-PDF-server/Chronicle-PDF-server.jar"

    # Wrapper script
    install -Dm755 /dev/stdin "${pkgdir}/usr/bin/Chronicle-PDF-server" << 'EOF'
#!/bin/sh
exec java $JAVA_OPTS -jar /usr/share/Chronicle-PDF-server/Chronicle-PDF-server.jar "$@"
EOF

    # systemd unit
    install -Dm644 /dev/stdin "${pkgdir}/usr/lib/systemd/system/Chronicle-PDF-server.service" << 'EOF'
[Unit]
Description=Chronicle-PDF Server
After=network.target

[Service]
Type=simple
User=Chronicle-PDF
Group=Chronicle-PDF
WorkingDirectory=/var/lib/Chronicle-PDF-server
ExecStart=/usr/bin/java -jar /usr/share/Chronicle-PDF-server/Chronicle-PDF-server.jar
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=Chronicle-PDF-server
Environment=JAVA_OPTS=-Xmx512m

[Install]
WantedBy=multi-user.target
EOF

    # sysusers
    install -Dm644 /dev/stdin "${pkgdir}/usr/lib/sysusers.d/Chronicle-PDF-server.conf" << 'EOF'
u Chronicle-PDF - "Chronicle-PDF Server" /var/lib/Chronicle-PDF-server -
EOF

    # tmpfiles
    install -Dm644 /dev/stdin "${pkgdir}/usr/lib/tmpfiles.d/Chronicle-PDF-server.conf" << 'EOF'
d /var/lib/Chronicle-PDF-server 0750 Chronicle-PDF Chronicle-PDF -
d /var/log/Chronicle-PDF-server 0750 Chronicle-PDF Chronicle-PDF -
EOF

    # Default config stub
    install -dm755 "${pkgdir}/etc/Chronicle-PDF-server"
    install -Dm644 /dev/stdin "${pkgdir}/etc/Chronicle-PDF-server/settings.yml" << 'EOF'
# Chronicle-PDF Server configuration
# See https://github.com/aaronkr-navi/Chronicle-PDF for all options
server:
  port: 8080
EOF

    # License
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" << 'EOF'
MIT License with proprietary carve-outs (open-core).
SPDX: MIT AND LicenseRef-Chronicle-PDF-Proprietary
See https://github.com/aaronkr-navi/Chronicle-PDF/blob/main/LICENSE
EOF
}
