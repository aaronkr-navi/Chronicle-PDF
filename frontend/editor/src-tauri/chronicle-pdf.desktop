[Desktop Entry]
Version=1.0
Type=Application
Name=Chronicle PDF
Comment=Desktop PDF editor — view, edit, sign, merge, split, and convert PDFs without external services
TryExec={{exec}}
Exec={{exec}} %F
Icon={{icon}}
Terminal=false
MimeType=application/pdf;
Categories=Office;Graphics;Utility;
Actions=open-file;
StartupWMClass=Chronicle-PDF

[Desktop Action open-file]
Name=Open PDF File
Exec={{exec}} %F
